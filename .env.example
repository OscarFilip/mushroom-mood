# REQUIRED: ArtDatabanken seasonal observation API key.
# If missing, seasonal evidence returns as unavailable and readiness falls back to the static
# species calendar with reduced confidence. App will not produce misleading results, but
# observation-backed seasonality will be unavailable.
ARTDATABANKEN_API_KEY=

# Logging configuration (optional).
# Set to 'debug', 'verbose', 'true', '1', or 'on' to enable verbose API logging.
MUSHROOM_MOOD_LOG_LEVEL=
ENABLE_VERBOSE_API_LOGGING=
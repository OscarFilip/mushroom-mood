# App environment identifier - safe for browser exposure
# Used to distinguish deployment environments (dev, beta, production, etc.)
NEXT_PUBLIC_APP_ENV=

# Weather API configuration - SMHI (Swedish Meteorological and Hydrological Institute)
# The app has a hardcoded default SMHI base URL; these can be left empty for defaults.
SMHI_API_BASE_URL=
SMHI_API_KEY=

# Seasonal observation API configuration - ArtDatabanken
# REQUIRED: ARTDATABANKEN_API_KEY must be set for seasonal evidence queries.
# If missing, seasonal observations will return as unavailable, and readiness will use fallback calendar.
ARTDATABANKEN_API_BASE_URL=
ARTDATABANKEN_API_KEY=

# iNaturalist API configuration
# Currently listed for future expansion; not actively used in current version.
INATURALIST_API_BASE_URL=
INATURALIST_API_KEY=

# Logging configuration (optional)
# Set to 'debug', 'verbose', 'true', '1', or 'on' to enable verbose API logging.
MUSHROOM_MOOD_LOG_LEVEL=
ENABLE_VERBOSE_API_LOGGING=
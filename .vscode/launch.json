{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug app",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:debug",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://localhost:\\d+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Attach: Next.js server",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}